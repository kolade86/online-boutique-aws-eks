# terraform/modules/observability/prometheus-values.yaml
# kube-prometheus-stack values for your infrastructure

global:
  imageRegistry: ""

# Prometheus configuration
prometheus:
  prometheusSpec:
    # Use your existing IRSA role
    serviceAccountName: monitoring-kube-prometheus-prometheus

    # Grafana Cloud Remote Write (AIOps ML features)
%{ if enable_grafana_cloud }
    remoteWrite:
      - url: "${grafana_cloud_remote_write_url}"
        basicAuth:
          username:
            name: grafana-cloud-credentials
            key: username
          password:
            name: grafana-cloud-credentials
            key: password
        writeRelabeling:
          - sourceLabels: [__name__]
            regex: "(up|container_cpu_usage_seconds_total|container_memory_working_set_bytes|kube_pod_status_phase|kube_deployment_status_replicas|kube_deployment_spec_replicas|node_cpu_seconds_total|node_memory_MemAvailable_bytes|node_memory_MemTotal_bytes|node_filesystem_avail_bytes|node_filesystem_size_bytes|http_request_duration_seconds.*|http_requests_total|grpc_server_handled_total|grpc_server_handling_seconds.*|kube_pod_container_resource_requests|kube_pod_container_resource_limits|container_network_receive_bytes_total|container_network_transmit_bytes_total|kube_node_status_condition|kube_pod_status_ready)"
            action: keep
%{ endif }

    # Configure external URL for subpath - using relative path for ALB compatibility
    externalUrl: "/prometheus/"
    routePrefix: "/prometheus/"

    # Retention settings
    retention: 30d
    retentionSize: 50GB

    # Resource limits
    resources:
      limits:
        cpu: 1000m
        memory: 4Gi
      requests:
        cpu: 500m
        memory: 2Gi

    # Storage configuration
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: gp3-monitoring
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 50Gi

    # Additional scrape configs for your microservices
    additionalScrapeConfigs:
      - job_name: kubernetes-pods
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
            target_label: __address__

      # Redis metrics scraping
      - job_name: redis-exporter
        static_configs:
          - targets: ['redis-exporter:9121']
        scrape_interval: 30s
        metrics_path: /metrics

  # Service account configuration
  serviceAccount:
    create: true
    name: monitoring-kube-prometheus-prometheus
    annotations:
      eks.amazonaws.com/role-arn: "${prometheus_role_arn}"

  # Disable individual Prometheus ingress
  ingress:
    enabled: false

# AlertManager configuration
alertmanager:
  alertmanagerSpec:
    # Use your existing IRSA role
    serviceAccountName: monitoring-kube-prometheus-alertmanager

    # Storage
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: gp3-monitoring
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 10Gi

    # Resource limits
    resources:
      limits:
        cpu: 200m
        memory: 512Mi
      requests:
        cpu: 100m
        memory: 256Mi

  # Service account configuration
  serviceAccount:
    create: true
    name: monitoring-kube-prometheus-alertmanager
    annotations:
      eks.amazonaws.com/role-arn: "${alertmanager_role_arn}"

  # AlertManager configuration
  config:
    global:
      smtp_smarthost: localhost:587
      smtp_from: "alertmanager@${project_name}.local"

    route:
      group_by: ['alertname']
      group_wait: 10s
      group_interval: 10s
      repeat_interval: 1h
      receiver: web.hook

    receivers:
      - name: web.hook
        sns_configs:
          - topic_arn: "${sns_topic_arn}"
            subject: "[${environment_upper}] Alert: {{ .GroupLabels.alertname }}"
            message: |
              {{ range .Alerts }}
              **Alert:** {{ .Annotations.summary }}
              **Description:** {{ .Annotations.description }}
              **Severity:** {{ .Labels.severity }}
              **Instance:** {{ .Labels.instance }}
              **Time:** {{ .StartsAt }}
              {{ end }}
            attributes:
              environment: "${environment}"
              cluster: "${cluster_name}"

# Grafana configuration
grafana:
  # Admin credentials from secret
  admin:
    existingSecret: "${grafana_secret_name}"
    userKey: admin-user
    passwordKey: admin-password

  # Persistence
  persistence:
    enabled: true
    storageClassName: gp3-monitoring
    size: 10Gi

  # Resource limits
  resources:
    limits:
      cpu: 500m
      memory: 1Gi
    requests:
      cpu: 250m
      memory: 512Mi

  # Configure Grafana to work behind a reverse proxy with subpath
  grafana.ini:
    server:
      root_url: "%(protocol)s://%(domain)s:%(http_port)s/grafana/"
      serve_from_sub_path: true

  # Disable individual Grafana ingress - we'll create a shared one
  ingress:
    enabled: false

  # Environment variables
  env:
    GF_INSTALL_PLUGINS: grafana-piechart-panel,grafana-worldmap-panel

  # Default dashboards
  defaultDashboardsEnabled: true

  # Additional dashboards for your microservices
  dashboardProviders:
    dashboardproviders.yaml:
      apiVersion: 1
      providers:
        - name: microservices
          orgId: 1
          folder: Microservices
          type: file
          disableDeletion: false
          editable: true
          options:
            path: /var/lib/grafana/dashboards/microservices
        - name: infrastructure
          orgId: 1
          folder: Infrastructure
          type: file
          disableDeletion: false
          editable: true
          options:
            path: /var/lib/grafana/dashboards/infrastructure

# Node Exporter (for host metrics)
nodeExporter:
  enabled: true
  serviceMonitor:
    enabled: true

# Kube State Metrics
kubeStateMetrics:
  enabled: true

# Prometheus Operator
prometheusOperator:
  resources:
    limits:
      cpu: 200m
      memory: 512Mi
    requests:
      cpu: 100m
      memory: 256Mi

# Default rules and alerts
defaultRules:
  create: true
  rules:
    alertmanager: true
    etcd: false  # Not needed for managed EKS
    configReloaders: true
    general: true
    k8s: true
    kubeApiserverAvailability: true
    kubeApiserverBurnrate: true
    kubeApiserverHistogram: true
    kubeApiserverSlos: true
    kubelet: true
    kubeProxy: false  # Disable if not needed
    kubePrometheusGeneral: true
    kubePrometheusNodeRecording: true
    kubernetesApps: true
    kubernetesResources: true
    kubernetesStorage: true
    kubernetesSystem: true
    kubeScheduler: false  # Disable for managed EKS
    kubeStateMetrics: true
    network: true
    node: true
    nodeExporterAlerting: true
    nodeExporterRecording: true
    prometheus: true
    prometheusOperator: true