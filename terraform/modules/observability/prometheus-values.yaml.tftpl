# terraform/modules/observability/prometheus-values.yaml
# kube-prometheus-stack values for your infrastructure

global:
  imageRegistry: ""

# Prometheus configuration
prometheus:
  prometheusSpec:
    # Use your existing IRSA role
    serviceAccountName: monitoring-kube-prometheus-prometheus

    # Retention settings
    retention: 30d
    retentionSize: 50GB

    # Resource limits
    resources:
      limits:
        cpu: 1000m
        memory: 4Gi
      requests:
        cpu: 500m
        memory: 2Gi

    # Storage configuration
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: gp3-monitoring
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 50Gi

    # Additional scrape configs for your microservices
    additionalScrapeConfigs:
      - job_name: kubernetes-pods
        kubernetes_sd_configs:
          - role: pod
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]
            action: keep
            regex: true
          - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]
            action: replace
            target_label: __metrics_path__
            regex: (.+)
          - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]
            action: replace
            regex: ([^:]+)(?::\d+)?;(\d+)
            replacement: $1:$2
            target_label: __address__

      # No redis-exporter job: no exporter is deployed, so a static
      # 'redis-exporter:9121' target was permanently down (TargetDown +
      # RedisDown). Redis is ElastiCache; its CPU, memory and evictions are
      # covered by CloudWatch alarms in main.tf.

  # Service account configuration
  serviceAccount:
    create: true
    name: monitoring-kube-prometheus-prometheus
    annotations:
      eks.amazonaws.com/role-arn: "${prometheus_role_arn}"

  # Private: no ingress is created for the monitoring stack
  ingress:
    enabled: false

# AlertManager configuration
alertmanager:
  alertmanagerSpec:
    # Use your existing IRSA role
    serviceAccountName: monitoring-kube-prometheus-alertmanager
%{ if sreagent_alerts_enabled ~}

    # Bearer token for the SRE agent's webhook, mounted at
    # /etc/alertmanager/secrets/sreagent-webhook/token. The Secret is created
    # by hand; without it Alertmanager cannot start.
    secrets:
      - sreagent-webhook
%{ endif ~}

    # Storage
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: gp3-monitoring
          accessModes:
            - ReadWriteOnce
          resources:
            requests:
              storage: 10Gi

    # Resource limits
    resources:
      limits:
        cpu: 200m
        memory: 512Mi
      requests:
        cpu: 100m
        memory: 256Mi

  # Service account configuration
  serviceAccount:
    create: true
    name: monitoring-kube-prometheus-alertmanager
    annotations:
      eks.amazonaws.com/role-arn: "${alertmanager_role_arn}"

  # AlertManager configuration
  config:
    global:
      smtp_smarthost: localhost:587
      smtp_from: "alertmanager@${project_name}.local"

    # Helm merges maps but replaces lists. The chart's default route.routes
    # sends Watchdog to a receiver named "null"; overriding `receivers`
    # below drops the chart's "null" receiver, and Alertmanager then refuses
    # the whole config ("undefined receiver "null" used in route"), so it
    # never started. Both the route and the receiver are therefore spelled
    # out here. Keep the "null" route FIRST in `routes`: it has no
    # `continue`, so the always-firing Watchdog and InfoInhibitor stop there
    # and never reach email (or any receiver added after it).
    route:
      group_by: ['alertname']
      group_wait: 10s
      group_interval: 10s
      repeat_interval: 1h
      receiver: web.hook
      routes:
        - receiver: "null"
          matchers:
            - 'alertname =~ "Watchdog|InfoInhibitor"'
%{ if sreagent_alerts_enabled ~}
        # SRE agent: only the chart's workload-health alerts in the app
        # namespace. Must match alerts.route_matchers() in src/sreagent
        # (a test there checks it). `continue` so they are emailed as well.
        - receiver: sre-agent
          continue: true
          matchers:
            - 'namespace="${app_namespace}"'
            - 'alertname=~"PodCrashLooping|PodNotReady|ContainerOOMKilled|HighCPUUsage|HighMemoryUsage|DeploymentReplicasMismatch|HpaMaxedOut"'
            - 'severity=~"warning|critical"'
        # A route that matched with `continue` stops the fall-back to the
        # parent's receiver, so email needs an explicit catch-all here.
        - receiver: web.hook
%{ endif ~}

    receivers:
      # Discards what is routed to it (no integrations configured).
      - name: "null"
%{ if sreagent_alerts_enabled ~}
      - name: sre-agent
        webhook_configs:
          - url: "http://sreagent.${app_namespace}.svc.cluster.local:8080/alert"
            send_resolved: false
            max_alerts: 10
            http_config:
              authorization:
                credentials_file: /etc/alertmanager/secrets/sreagent-webhook/token
%{ endif ~}
      - name: web.hook
        sns_configs:
          - topic_arn: "${sns_topic_arn}"
            # Plain text: SNS email does not render Markdown, so the old
            # "**Alert:**" markers arrived literally. One block per alert,
            # with the target (service/job/pod) that the old template left out.
            subject: "[${environment_upper}] {{ .Status | toUpper }}: {{ .GroupLabels.alertname }} ({{ len .Alerts }})"
            message: |
              {{ .Status | toUpper }}: {{ .GroupLabels.alertname }}, {{ len .Alerts }} alert(s)
              {{ range .Alerts }}
              {{ .Annotations.summary }}
                Status:    {{ .Status }}
                Severity:  {{ .Labels.severity }}
                Namespace: {{ or .Labels.namespace "-" }}
                Target:    {{ with .Labels.service }}service={{ . }} {{ end }}{{ with .Labels.job }}job={{ . }} {{ end }}{{ with .Labels.pod }}pod={{ . }} {{ end }}{{ with .Labels.instance }}instance={{ . }}{{ end }}
                Details:   {{ .Annotations.description }}
                Started:   {{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}
                Runbook:   {{ or .Annotations.runbook_url "-" }}
              {{ end }}
            attributes:
              environment: "${environment}"
              cluster: "${cluster_name}"

# Grafana configuration
grafana:
  # Admin credentials from secret
  admin:
    existingSecret: "${grafana_secret_name}"
    userKey: admin-user
    passwordKey: admin-password

  # Persistence
  persistence:
    enabled: true
    storageClassName: gp3-monitoring
    size: 10Gi

  # Resource limits
  resources:
    limits:
      cpu: 500m
      memory: 1Gi
    requests:
      cpu: 250m
      memory: 512Mi

  # Served at the root path - accessed via kubectl port-forward, not an ingress
  # Private: no ingress is created for the monitoring stack
  ingress:
    enabled: false

  # Environment variables
  env:
    GF_INSTALL_PLUGINS: grafana-piechart-panel,grafana-worldmap-panel

  # Default dashboards
  defaultDashboardsEnabled: true

  # Additional dashboards for your microservices
  dashboardProviders:
    dashboardproviders.yaml:
      apiVersion: 1
      providers:
        - name: microservices
          orgId: 1
          folder: Microservices
          type: file
          disableDeletion: false
          editable: true
          options:
            path: /var/lib/grafana/dashboards/microservices
        - name: infrastructure
          orgId: 1
          folder: Infrastructure
          type: file
          disableDeletion: false
          editable: true
          options:
            path: /var/lib/grafana/dashboards/infrastructure

# Node Exporter (for host metrics)
nodeExporter:
  enabled: true
  serviceMonitor:
    enabled: true

# Kube State Metrics
kubeStateMetrics:
  enabled: true

# Prometheus Operator
prometheusOperator:
  resources:
    limits:
      cpu: 200m
      memory: 512Mi
    requests:
      cpu: 100m
      memory: 256Mi

# EKS runs the control plane: the scheduler, controller-manager and etcd are
# not reachable from inside the cluster. Leaving these enabled creates
# Services and ServiceMonitors with no endpoints, and the absent(up{...})
# rules then fire forever (KubeSchedulerDown, KubeControllerManagerDown).
kubeScheduler:
  enabled: false
kubeControllerManager:
  enabled: false
kubeEtcd:
  enabled: false

# Default rules and alerts
defaultRules:
  create: true
  rules:
    alertmanager: true
    etcd: false  # Not needed for managed EKS
    configReloaders: true
    general: true
    k8s: true
    kubeApiserverAvailability: true
    kubeApiserverBurnrate: true
    kubeApiserverHistogram: true
    kubeApiserverSlos: true
    kubelet: true
    kubeProxy: false  # Disable if not needed
    kubePrometheusGeneral: true
    kubePrometheusNodeRecording: true
    kubernetesApps: true
    kubernetesResources: true
    kubernetesStorage: true
    kubernetesSystem: true
    # Not reachable on EKS (see above). The chart's keys are
    # kubeSchedulerAlerting/kubeSchedulerRecording; a plain "kubeScheduler"
    # key is ignored, which is why KubeSchedulerDown still fired.
    kubeSchedulerAlerting: false
    kubeSchedulerRecording: false
    kubeControllerManager: false
    kubeStateMetrics: true
    network: true
    node: true
    nodeExporterAlerting: true
    nodeExporterRecording: true
    prometheus: true
    prometheusOperator: true