{
  "uid": "sreagent",
  "title": "SRE agent",
  "description": "What the SRE agent does, how long it takes and what it costs, from its /metrics endpoint (src/sreagent/metrics.py). Counts and totals over the dashboard's time range; no rates.",
  "tags": [
    "sreagent",
    "online-boutique"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Namespace",
        "query": {
          "query": "label_values(sreagent_info, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(sreagent_info, namespace)",
        "refresh": 2,
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Activity",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "id": 2,
      "title": "Investigations in range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum(increase(sreagent_investigations_total{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "investigations",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "title": "Estimated cost in range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Token counts times model_prices.json, an estimate.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(sreagent_cost_usd_total{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "cost",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
      "title": "Alerts added to an incident in range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Alerts for a service investigated recently: not investigated again.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum(increase(sreagent_alert_decisions_total{namespace=\"$namespace\", decision=\"added_to_incident\"}[$__range])))",
          "legendFormat": "added to an incident",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "id": 5,
      "title": "Investigating now",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(sreagent_investigation_in_progress{namespace=\"$namespace\"})",
          "legendFormat": "in progress",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "id": 6,
      "title": "Model",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (model) (sreagent_info{namespace=\"$namespace\"})",
          "legendFormat": "{{model}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "id": 7,
      "title": "Investigations per interval, by kind and outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Alerts and /ask questions, by how they ended. Each bar is the total in that interval.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum by (kind, outcome) (increase(sreagent_investigations_total{namespace=\"$namespace\"}[$__interval]))) > 0",
          "legendFormat": "{{kind}} {{outcome}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "barAlignment": 0,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m"
    },
    {
      "id": 8,
      "title": "Alert decisions per interval",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "One per incident in each /alert call: investigated, added to an incident investigated recently, skipped as busy, or not worth investigating. Each bar is the total in that interval.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum by (decision) (increase(sreagent_alert_decisions_total{namespace=\"$namespace\"}[$__interval]))) > 0",
          "legendFormat": "{{decision}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "barAlignment": 0,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m"
    },
    {
      "id": 9,
      "title": "Alert decisions by service in range",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Alerts about the app's services. A service's very first decision after the agent starts is not counted (its series appears with that decision in it).",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum by (service, decision) (increase(sreagent_alert_decisions_total{namespace=\"$namespace\", service!=\"-\"}[$__range]))) > 0",
          "legendFormat": "{{service}}: {{decision}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left"
      }
    },
    {
      "type": "row",
      "title": "Speed and effort",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 10
    },
    {
      "id": 11,
      "title": "Duration in range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Over the dashboard's time range. With few investigations a percentile is interpolated between bucket edges; the average is exact.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(sreagent_investigation_duration_seconds_sum{namespace=\"$namespace\"}[$__range])) / sum(increase(sreagent_investigation_duration_seconds_count{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "average",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(sreagent_investigation_duration_seconds_bucket{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "p50",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (increase(sreagent_investigation_duration_seconds_bucket{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "p90",
          "refId": "C",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (increase(sreagent_investigation_duration_seconds_bucket{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "p99",
          "refId": "D",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "id": 12,
      "title": "Tool calls per investigation in range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Over the dashboard's time range. With few investigations a percentile is interpolated between bucket edges; the average is exact. Alerts and questions are counted together; each has its own budget: SREAGENT_MAX_TOOL_CALLS for alerts (15 by default), SREAGENT_MAX_TOOL_CALLS_ASK for questions (20 by default).",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(sreagent_investigation_tool_calls_sum{namespace=\"$namespace\"}[$__range])) / sum(increase(sreagent_investigation_tool_calls_count{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "average",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(sreagent_investigation_tool_calls_bucket{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "p50",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (increase(sreagent_investigation_tool_calls_bucket{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "p90",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "id": 13,
      "title": "Duration distribution",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "How long investigations took. Answers usually take 20 to 60 seconds. Each column is the total in that interval.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (le) (increase(sreagent_investigation_duration_seconds_bucket{namespace=\"$namespace\"}[$__interval])) > 0",
          "legendFormat": "{{le}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "scheme": "Blues"
        },
        "cellGap": 1,
        "legend": {
          "show": true
        }
      },
      "interval": "5m"
    },
    {
      "id": 14,
      "title": "Tool calls by tool in range",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Every call, ok or error.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum by (tool, result) (increase(sreagent_tool_calls_total{namespace=\"$namespace\"}[$__range]))) > 0",
          "legendFormat": "{{tool}} {{result}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left"
      }
    },
    {
      "id": 15,
      "title": "Tool call errors per interval",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Each bar is the total in that interval.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "round(sum by (tool) (increase(sreagent_tool_calls_total{namespace=\"$namespace\", result=\"error\"}[$__interval]))) > 0",
          "legendFormat": "{{tool}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "barAlignment": 0,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m"
    },
    {
      "type": "row",
      "title": "Cost (estimated from token counts and model_prices.json)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "id": 16
    },
    {
      "id": 17,
      "title": "Cost per investigation in range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Over the dashboard's time range. With few investigations a percentile is interpolated between bucket edges; the average is exact.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(sreagent_investigation_cost_usd_sum{namespace=\"$namespace\"}[$__range])) / sum(increase(sreagent_investigation_cost_usd_count{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "average",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(sreagent_investigation_cost_usd_bucket{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "p50",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (increase(sreagent_investigation_cost_usd_bucket{namespace=\"$namespace\"}[$__range])))",
          "legendFormat": "p90",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
    {
      "id": 18,
      "title": "Cache reads as a share of input in range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Each loop step resends the conversation; cached prefixes are billed at the cache-read rate.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(sreagent_model_tokens_total{namespace=\"$namespace\", type=\"cache_read\"}[$__range])) / sum(increase(sreagent_model_tokens_total{namespace=\"$namespace\", type=~\"input|cache_read|cache_write\"}[$__range]))",
          "legendFormat": "cache reads",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "percentunit",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
