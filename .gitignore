# Terraform
# NOTE: the environment .terraform.lock.hcl is deliberately NOT ignored. It
# pins provider versions so local runs and CI resolve identically.
# Module-level lock files are ignored: they are only produced by the
# standalone `terraform init -backend=false` used for validation, and the root
# module is what actually pins versions.
terraform/modules/*/.terraform.lock.hcl
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfvars.backup
tfplan
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform provider binaries
terraform/environments/dev/.terraform/providers/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.iml

# Docker
*.log

# Build artifacts
build-all.sh

# Claude Code
CLAUDE.md
HELM-GUIDE.md

# Git
.git/
argocd.exe
